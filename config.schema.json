{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auto-comfy-draw config",
  "description": "Parameter contract for pipeline.py / pipeline_twopass.py config files.",
  "type": "object",
  "required": [
    "model"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "description": "Default series name and server subfolder.",
      "default": "demo",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "description": "Checkpoint filename; must be one of the names reported by --discover.",
      "minLength": 1
    },
    "lora": {
      "type": [
        "string",
        "null"
      ],
      "description": "LoRA filename (optional)."
    },
    "lora_strength": {
      "type": "number",
      "default": 0.9,
      "description": "LoRA strength; lower (0.4-0.6) for reference-image work."
    },
    "positive": {
      "type": "string",
      "description": "Base positive prompt (danbooru/Illustrious style)."
    },
    "negative": {
      "type": "string",
      "description": "Negative prompt."
    },
    "width": {
      "type": "integer",
      "default": 832,
      "multipleOf": 8,
      "minimum": 8
    },
    "height": {
      "type": "integer",
      "default": 1216,
      "multipleOf": 8,
      "minimum": 8
    },
    "steps": {
      "type": "integer",
      "default": 28,
      "minimum": 1
    },
    "cfg": {
      "type": "number",
      "default": 6.5,
      "minimum": 0
    },
    "sampler": {
      "type": "string",
      "default": "dpmpp_2m"
    },
    "scheduler": {
      "type": "string",
      "default": "karras"
    },
    "denoise": {
      "type": "number",
      "default": 1.0,
      "minimum": 0,
      "maximum": 1
    },
    "start_cmd": {
      "type": "string",
      "default": "",
      "description": "Command to launch ComfyUI; used by --start after user consent."
    },
    "server_out": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legacy string alias for server_output_dir. CLI --server-out overrides both."
    },
    "server_output_dir": {
      "type": [
        "string",
        "null"
      ],
      "description": "Server output root used for path reporting and sequence reads; does not reconfigure ComfyUI."
    },
    "server_sub": {
      "type": [
        "string",
        "null"
      ],
      "description": "Subfolder under the server output root."
    },
    "output_dir": {
      "type": "string",
      "description": "Client download directory; optional in direct mode."
    },
    "prefix": {
      "type": "string",
      "description": "Filename prefix / subfolder for saved images."
    },
    "prompts": {
      "type": "array",
      "description": "Named prompts selectable with --names.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name",
              "prompt"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "detail": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "face": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "cfg": {
              "type": "number",
              "minimum": 0
            },
            "denoise": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "guide_size": {
              "type": "number",
              "minimum": 1
            },
            "max_size": {
              "type": "number",
              "minimum": 1
            },
            "feather": {
              "type": "integer",
              "minimum": 0
            },
            "sam": {
              "type": [
                "string",
                "null"
              ]
            },
            "bbox_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bbox_crop_factor": {
              "type": "number",
              "minimum": 1
            },
            "bbox_dilation": {
              "type": "number"
            }
          }
        },
        "hand": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "detector": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "cfg": {
              "type": "number",
              "minimum": 0
            },
            "denoise": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "guide_size": {
              "type": "number",
              "minimum": 1
            },
            "max_size": {
              "type": "number",
              "minimum": 1
            },
            "feather": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "crop_factor": {
              "type": "number",
              "minimum": 1
            },
            "dilation": {
              "type": "number"
            }
          }
        },
        "upscale": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "target_width": {
              "type": "integer",
              "minimum": 8,
              "multipleOf": 8
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "output_dir"
      ],
      "properties": {
        "output_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "required": [
        "server_output_dir"
      ],
      "properties": {
        "server_output_dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "required": [
        "server_out"
      ],
      "properties": {
        "server_out": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
